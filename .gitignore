# Secrets and per-machine config.
.env
.env.*
*.key
.secrets/

# Python and tooling.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/

# OS and editors.
.DS_Store
.vscode/
.idea/
