# Data, model checkpoints and run outputs live on the external drive, never in git.
data/
runs/
models/
adapters/
*.safetensors
*.npz
*.gguf

# Licensed or third-party text, gold test labels, and the contents of sealed forecasts.
# Only hash manifests (research/ledger/) are committed.
corpus/
transcripts/
gold/
sealed/
